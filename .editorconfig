root = true

[*.{cpp,hpp,h,c,js,py,md,yml,yaml}]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[src/{business,ui,library,sources,lxsource,provider,background,platform,desktop,audio,main}.{cpp,hpp}]
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.py]
indent_style = space
indent_size = 4
