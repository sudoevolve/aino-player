root = true

[*.{cpp,hpp,h,c,js,py,md,yml,yaml}]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[src/*.{cpp,hpp,h}]
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[src/{aino.hpp,miniaudio.h}]
indent_style = unset
indent_size = unset
trim_trailing_whitespace = unset

[*.py]
indent_style = space
indent_size = 4
