# 换行符：Windows 批处理必须是 CRLF，shell 脚本必须是 LF。
* text=auto
*.bat text eol=crlf
*.sh  text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.h   text eol=lf
*.md  text eol=lf
*.desktop text eol=lf
*.yml text eol=lf
# 保留上游 vendored 头文件中的原始行尾空格，不对第三方源码做格式改写。
vendor/miniaudio/miniaudio.h whitespace=-blank-at-eol

# 二进制
*.lib binary
*.png binary
*.bmp binary

# APT public trust files must keep their published bytes.
packaging/apt/*.sources text eol=lf
packaging/apt/*.gpg binary
packaging/rpm/*.repo text eol=lf
packaging/arch/*.conf text eol=lf
