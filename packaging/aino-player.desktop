[Desktop Entry]
Type=Application
Name=aino player
GenericName=Music Player
GenericName[zh_CN]=音乐播放器
Comment=Discover music, play songs and manage local favorites
Comment[zh_CN]=发现音乐、播放歌曲与管理本地收藏
Exec=aino_player --open %U
TryExec=aino_player
Icon=aino-player
Terminal=false
Categories=AudioVideo;Audio;Player;
MimeType=audio/mpeg;audio/flac;audio/x-flac;audio/wav;audio/x-wav;audio/mp4;audio/x-m4a;audio/aac;audio/x-aac;audio/ogg;audio/x-vorbis+ogg;application/ogg;audio/opus;audio/webm;
StartupNotify=true
StartupWMClass=aino-player
