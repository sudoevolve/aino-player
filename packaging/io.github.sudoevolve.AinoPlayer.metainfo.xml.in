<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.sudoevolve.AinoPlayer</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>Apache-2.0</project_license>
  <name>Aino Player</name>
  <summary>Discover music and manage local playlists</summary>
  <summary xml:lang="zh-CN">发现音乐、播放歌曲与管理本地歌单</summary>
  <developer_name>sudoevolve@gmail.com</developer_name>
  <update_contact>sudoevolve@gmail.com</update_contact>
  <description>
    <p>A lightweight desktop music player with online search, streaming playback, lyrics, local favorites and playlists.</p>
    <p xml:lang="zh-CN">轻量桌面音乐播放器，支持在线搜索、流式播放、歌词、本地收藏与歌单管理。</p>
  </description>
  <launchable type="desktop-id">aino-player.desktop</launchable>
  <provides><binary>aino_player</binary></provides>
  <url type="homepage">https://github.com/sudoevolve/aino-player</url>
  <url type="bugtracker">https://github.com/sudoevolve/aino-player/issues</url>
  <categories><category>AudioVideo</category><category>Audio</category><category>Player</category></categories>
  <releases><release version="@PROJECT_VERSION@" date="@AINO_PACKAGE_DATE@"/></releases>
</component>
